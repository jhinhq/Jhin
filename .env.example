# Jhin — environment configuration (infrastructure only; plan section 39).
# User-added credentials (GitHub, Linear, model API keys, ...) are stored in
# the encrypted application secret store, never in this file.

# --- Application ---
APP_NAME=Jhin
# APP_ENV=production
# Public URL of the web UI (used for CORS).
APP_URL=http://localhost:3000

LOG_LEVEL=INFO

# --- Published ports ---
WEB_PORT=3000
API_PORT=8000

# --- PostgreSQL (system of record) ---
POSTGRES_USER=jhin
POSTGRES_PASSWORD=jhin
POSTGRES_DB=jhin

# --- Temporal ---
TEMPORAL_NAMESPACE=default

# --- Secret encryption (plan section 13) ---
# Host path of the master key file mounted into api/agent-worker/tool-worker as
# /run/secrets/jhin_master_key. Create it once with `make master-key`.
# Losing this file makes every stored secret permanently unreadable.
MASTER_KEY_FILE_HOST=./secrets/dev/jhin_master_key

# --- Sandbox runner (plan section 14, 39) ---
# Shared bearer token the tool worker presents to the internal sandbox
# runner API. Set a strong random value in production; the API is also
# network-isolated (compose `runner` network, never published).
SANDBOX_RUNNER_TOKEN=dev-sandbox-runner-token
# Default job image (built via `make sandbox-image` / compose profile
# "build"). Grants can restrict which images an agent may request.
SANDBOX_DEFAULT_IMAGE=jhin-sandbox:latest
# Dedicated Docker bridge network for network_policy=internet jobs. Must
# never carry control-plane services.
# SANDBOX_NETWORK=jhin_sandbox
# Where the tool worker reaches the runner (compose sets this; override
# only for unusual topologies).
# SANDBOX_RUNNER_URL=http://sandbox-runner:8085
# Locally built runner/adapter image. Both services render this exact tag;
# the adapter is never pulled independently.
# SANDBOX_RUNNER_IMAGE=jhin-sandbox-runner:local
# Select exactly one verified Docker authority overlay when starting Compose.
# Rootful requires an absolute, root-owned Unix socket and its positive group.
# SANDBOX_DOCKER_SOCKET_HOST=/var/run/docker.sock
# SANDBOX_DOCKER_GID=20
# Rootless requires an already-running UID-10001 host socket. No GID applies.
# PHASE10_ROOTLESS_DOCKER_SOCKET=/run/user/10001/docker.sock

# --- Connector outbound target policy (operator-only) ---
# Optional comma-separated exact HTTP origins for trusted self-hosted or dev
# providers. Each entry must be a complete scheme://host[:port] origin with no
# path, query, fragment, or URL credentials. Official SaaS origins are built in.
# Keep this empty unless an operator intentionally authorizes credentialed
# connector traffic to every listed origin; never populate it from user input.
JHIN_CONNECTOR_ALLOWED_HTTP_ORIGINS=
# Optional comma-separated exact PostgreSQL host[:port] entries for trusted
# self-hosted or dev databases (an omitted port means 5432). Allowlisted entries
# intentionally bypass the hosted Supabase hostname/TLS-shape checks, though
# Jhin's own application database remains forbidden. Keep this empty by default,
# require TLS in each production DSN, and never populate it from user input.
JHIN_CONNECTOR_ALLOWED_DB_HOSTS=

# --- Fake model provider (dev/test only; compose.dev.yaml) ---
# Base URL `make seed` writes into the seeded "Fake Provider (dev)" row.
# Default reaches the fake-provider compose service from the agent worker.
# FAKE_PROVIDER_BASE_URL=http://fake-provider:8080/v1

# --- Fake GitHub REST API (dev/test only; compose.dev.yaml) ---
# The GitHub connector exit tests point connections at this service via
# config_json.base_url (in-network: http://fake-github:8080).
# FAKE_GITHUB_TOKEN=fake-github-pat
# FAKE_GITHUB_REPOS=octo/alpha,octo/beta

# --- Fake Linear GraphQL API (dev/test only; compose.dev.yaml) ---
# The Linear connector + trigger exit tests point connections at this
# service via config_json.base_url (in-network: http://fake-linear:8080).
# Its admin endpoints simulate issue transitions and fire signed webhooks.
# FAKE_LINEAR_API_KEY=fake-linear-api-key

# --- Dev-only localhost port bindings (compose.dev.yaml) ---
# POSTGRES_DEV_PORT=55432
# NATS_DEV_PORT=4222
# NATS_MONITOR_DEV_PORT=8222
# TEMPORAL_DEV_PORT=7233
# TEMPORAL_UI_DEV_PORT=8233
# FAKE_PROVIDER_DEV_PORT=8090
# FAKE_GITHUB_DEV_PORT=8091
# FAKE_LINEAR_DEV_PORT=8092
# SANDBOX_RUNNER_DEV_PORT=8093
# FAKE_VERCEL_DEV_PORT=8094
# FAKE_SUPABASE_DEV_PORT=8095
# FAKE_SUPABASE_DB_DEV_PORT=55433

# --- Supabase database connector fixture (dev/test only) ---
# These credentials belong only to fake-supabase-db in compose.dev.yaml.
# Reader role: jhin_reader; writer role: jhin_writer; fixture admin: postgres.
# JHIN_PHASE9_DB_READER_DSN=postgresql://jhin_reader:reader-pass@127.0.0.1:55433/supabase_fixture
# JHIN_PHASE9_DB_WRITER_DSN=postgresql://jhin_writer:writer-pass@127.0.0.1:55433/supabase_fixture
# JHIN_PHASE9_DB_ADMIN_DSN=postgresql://postgres:phase9-fixture-admin-only@127.0.0.1:55433/supabase_fixture
