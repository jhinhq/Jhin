# --- Application ---------------------------------------------------------
# Display name used for branding across the stack.
APP_NAME=Jhin
# One of: dev | production | test
APP_ENV=production
# Public URL of the web UI (used for CORS allowlisting).
APP_URL=http://localhost:3000
# Public URL of the API as seen from the browser / operators.
API_URL=http://localhost:8000
# Log level for all Python services: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PostgreSQL (system of record) ---------------------------------------
POSTGRES_USER=jhin
POSTGRES_PASSWORD=jhin
POSTGRES_DB=jhin
# Async SQLAlchemy URL used by the API and workers (host `postgres` inside compose).
DATABASE_URL=postgresql+asyncpg://jhin:jhin@postgres:5432/jhin

# --- NATS JetStream (event backbone) --------------------------------------
NATS_URL=nats://nats:4222

# --- Temporal (durable workflow authority) --------------------------------
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# --- Web (Next.js) ---------------------------------------------------------
# URL the web server uses to reach the API from inside the compose network.
API_INTERNAL_URL=http://api:8000

# --- Secrets (later phases) ------------------------------------------------
# Master encryption key file (mounted, never stored in Postgres).
# MASTER_KEY_FILE=/run/secrets/jhin_master_key
# SESSION_SECRET_FILE=/run/secrets/jhin_session_secret
